# Mindhub OAuth Facade Environment Configuration Example
#
# IMPORTANT SECURITY RULES:
# 1. Copy this file to a secure location (e.g. /etc/mindhub-oauth/env).
# 2. Set strict file permissions immediately: chmod 0600 /etc/mindhub-oauth/env
# 3. Ensure the file is owned by the service user: chown hermes:hermes /etc/mindhub-oauth/env
# 4. NEVER commit real secrets or .env files to git.
# 5. Do NOT set FACADE_ALLOW_INSECURE_LOCAL in production.

# ==============================================================================
# Mandatory Configuration
# ==============================================================================

# Public HTTPS URL of the facade reachable by external clients through Cloudflare Tunnel.
# MUST start with https:// and MUST NOT contain a path or trailing slash.
FACADE_PUBLIC_URL="https://CHANGE_ME_OAUTH_HOSTNAME.example.com"

# Internal Mindhub API Key injected upstream by the facade.
# MUST match one of the keys in Mindhub's MINDHUB_API_KEYS.
MINDHUB_UPSTREAM_API_KEY="CHANGE_ME_UPSTREAM_API_KEY"

# Scrypt hash of the owner password used to authenticate at /authorize/decision.
# Generate using: python -m mindhub_oauth hash-password
# Password must be at least 14 characters.
FACADE_OWNER_PASSWORD_HASH="CHANGE_ME_SCRYPT_HASH"

# Absolute path to the SQLite state database for clients, codes, and tokens.
# Directory MUST exist, be writable by service user, and protected by UMask=0077.
FACADE_DB_PATH="/var/lib/mindhub-oauth/oauth.db"

# ==============================================================================
# Network & Proxy Binding (Default Loopback)
# ==============================================================================

# Local address to bind the facade server. MUST be a loopback IP (127.0.0.1).
FACADE_HOST="127.0.0.1"

# Local port to bind the facade server.
FACADE_PORT="8089"

# Full upstream endpoint for Mindhub's MCP service. MUST be http:// loopback.
FACADE_UPSTREAM_URL="http://127.0.0.1:8088/mcp"

# ==============================================================================
# Scopes & Permissions
# ==============================================================================

# Maximum scope allowable by the facade. To permit write tools (remember, update_project_state),
# change to: "mindhub:read mindhub:write"
FACADE_MAX_SCOPE="mindhub:read"

# Default scope advertised in 401 challenge and granted when client omits scope.
FACADE_DEFAULT_SCOPE="mindhub:read"

# ==============================================================================
# Token Lifetimes & Limits
# ==============================================================================

# Authorization code single-use lifetime in seconds (default: 60).
FACADE_CODE_TTL_SECONDS="60"

# Access token lifetime in seconds (default: 900 = 15 minutes).
FACADE_ACCESS_TTL_SECONDS="900"

# Refresh token rotation lifetime in seconds (default: 2592000 = 30 days).
FACADE_REFRESH_TTL_SECONDS="2592000"

# Maximum registered active clients permitted in DCR (default: 50).
FACADE_MAX_CLIENTS="50"

# Optional comma-separated extra redirect URIs (e.g. pinned Gemini connector callbacks).
# FACADE_EXTRA_REDIRECT_URIS=""

# ==============================================================================
# Security & Headers
# ==============================================================================

# Trust CF-Connecting-IP header for rate limiting ONLY when request comes from loopback peer.
FACADE_TRUST_CF_HEADERS="true"

# Return 200 meta-refresh HTML response instead of 302 redirect for Google connector hosts.
FACADE_GOOGLE_META_REFRESH="true"
